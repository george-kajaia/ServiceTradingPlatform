{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "additionalDirectories": ["../../ServiceTokenAPI"],
    "allow": [
      "Bash(npm install)",
      "Bash(npm ci)",
      "Bash(npm run build*)",
      "Bash(npx ng build*)",
      "Bash(npx ng test*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git fetch*)",
      "Bash(ls*)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(wc *)",
      "Bash(node .claude/hooks/*)"
    ],
    "deny": [
      "Read(../../ServiceTokenAPI/PPK Files/**)",
      "Read(../../ServiceTokenAPI/**/*.ppk)",
      "Edit(../../ServiceTokenAPI/**)",
      "Write(../../ServiceTokenAPI/**)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git commit --amend*)",
      "Bash(git commit *--no-verify*)",
      "Bash(git push *--no-verify*)",
      "Bash(git config --global *)",
      "Bash(git filter-branch*)",
      "PowerShell(Remove-Item * -Recurse*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git reset --hard*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-push-verify.mjs\"",
            "timeout": 600,
            "statusMessage": "Pre-push build gate"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/check-uncommitted.mjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
